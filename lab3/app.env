# Env-файл для сервиса app: подключён в docker-compose.yml строкой env_file.
# Формат: ИМЯ=значение, одна переменная на строку. Compose передаёт эти
# переменные в контейнер, а программа читает их через os.environ.
#
# LOG_FILE — путь к файлу, куда программа дублирует логи (пункт 6.7 задания).
# В лог-файл попадает исходный текст ошибок базы, который пользователь на экране не видит.
# Папка /logs внутри контейнера — это том app_logs, поэтому файл сохраняется
# после выхода из программы. Посмотреть его:
#   docker compose run --rm --no-deps app cat /logs/autoservice.log
#
# Логина и пароля здесь нет специально: по заданию их вводит пользователь.
LOG_FILE=/logs/autoservice.log
