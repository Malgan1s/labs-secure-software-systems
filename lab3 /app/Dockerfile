# Образ программы autoservice.py. Собирается командой
#   docker build -t rzps-autoservice:1.0 ./app
# Ключ -t задаёт имя и тег образа (rzps-autoservice и 1.0),
# ./app — папка, где лежат этот Dockerfile и файлы программы.
# Каждая инструкция ниже (FROM, ENV, COPY, RUN...) — один шаг сборки.

# FROM — базовый образ, от которого отталкиваемся.
# python:3.13-slim — урезанный Debian с установленным Python 3.13. В нём нет
# лишних программ, поэтому образ меньше, а уязвимостей в нём меньше.
FROM python:3.13-slim

# ENV — переменная среды внутри контейнера.
# PYTHONUNBUFFERED со значением 1 отключает буферизацию вывода Python:
# сообщения программы сразу появляются в терминале и в docker logs.
ENV PYTHONUNBUFFERED=1

# WORKDIR — рабочая папка внутри контейнера. Папка /app создаётся сама,
# и все следующие команды (COPY, RUN, CMD) выполняются в ней.
WORKDIR /app

# Сначала копируем только список зависимостей и устанавливаем их.
# Docker запоминает (кэширует) результат каждого шага: пока requirements.txt
# не менялся, pip install при пересборке не повторяется, и сборка идёт быстрее.
# В requirements.txt одна зависимость: psycopg2-binary — драйвер PostgreSQL
# для Python. Версия в нём зафиксирована, чтобы сборка всегда давала одно и то же.
# --no-cache-dir — не хранить скачанные архивы пакетов в образе, он станет меньше.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Теперь копируем саму программу и её файл настроек config.json
# (точка и ./ означают текущую папку, то есть /app).
# Пароля в образе нет: его вводит пользователь при запуске программы.
COPY autoservice.py config.json ./

# Создаём обычного пользователя appuser (useradd) и папку /logs для лог-файла
# (mkdir), затем отдаём эту папку пользователю appuser (chown), чтобы он мог
# в неё писать. Обратная косая черта в конце строки продолжает ту же команду
# RUN на следующей строке, а && значит «выполнить следующее, если предыдущее
# прошло успешно».
RUN useradd --create-home appuser \
    && mkdir /logs \
    && chown appuser /logs
# USER — дальше всё, включая саму программу, работает от appuser, а не от root.
# Если программу взломают, у атакующего внутри контейнера не будет прав root.
USER appuser

# CMD — команда, которая выполняется при запуске контейнера:
# python autoservice.py в папке /app. Порты не открываем (нет EXPOSE):
# программа сама подключается к базе и никаких подключений не принимает.
CMD ["python", "autoservice.py"]
